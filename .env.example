# Ключ любого OpenAI-совместимого API. Оставьте пустым для локального режима.
AI_API_KEY=

# OpenAI: https://api.openai.com/v1
# Для другого провайдера укажите его OpenAI-compatible endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=10

# true — показывать причину ошибки AI API
DEBUG=false
